{
  "expo": {
    "name": "GISABO Mobile",
    "slug": "gisabo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gisabo.mobile"
    },
    "android": {
      "package": "com.gisabo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "gisabo",
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "react-native-square-in-app-payments",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 250
        }
      ]
    ]
  }
}
