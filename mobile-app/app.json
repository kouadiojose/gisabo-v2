{
  "expo": {
    "name": "GISABO Mobile",
    "slug": "gisabo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gisabo.mobile"
    },
    "android": {
      "package": "com.gisabo.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "gisabo",
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "react-native-square-in-app-payments"
    ]
  }
}
